#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
run_python_tests — запускаемый файл для Python-тестов GPUWorkLib (Debian/Linux)
================================================================================

Использование:
    ./run_python_tests              # все тесты
    ./run_python_tests -m filters   # один модуль
    ./run_python_tests -v           # verbose
    ./run_python_tests --help       # справка

Требования:
    pip install -r requirements.txt
    (numpy, pytest, scipy, matplotlib)

Сборка:
    cmake --build build --target gpuworklib  # или полная сборка проекта
"""
import os
import subprocess
import sys
from pathlib import Path

PROJECT_ROOT = Path(__file__).parent.resolve()
RUN_TESTS = PROJECT_ROOT / "run_tests.py"

def main():
    if not RUN_TESTS.exists():
        print(f"[ERROR] run_tests.py не найден: {RUN_TESTS}", file=sys.stderr)
        sys.exit(1)

    # Проверка зависимостей
    try:
        import numpy  # noqa: F401
    except ImportError:
        print("[ERROR] numpy не установлен. Выполни: pip install -r requirements.txt", file=sys.stderr)
        sys.exit(1)
    try:
        import pytest  # noqa: F401
    except ImportError:
        print("[ERROR] pytest не установлен. Выполни: pip install -r requirements.txt", file=sys.stderr)
        sys.exit(1)

    os.chdir(PROJECT_ROOT)
    sys.argv[0] = str(RUN_TESTS)
    sys.exit(subprocess.run([sys.executable, str(RUN_TESTS)] + sys.argv[1:]).returncode)


if __name__ == "__main__":
    main()
