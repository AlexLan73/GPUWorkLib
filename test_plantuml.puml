@startuml
title GPUWorkLib - Архитектура модулей

package "DrvGPU" {
  [GPUContext]
  [GPUProfiler]
  [CommandQueue]
  [console_output]
}

package "Modules" {
  [SignalGenerators]
  [FFTProcessor]
  [Filters]
  [Statistics]
  [Heterodyne]
}

package "Python Bindings" {
  [pybind11]
}

[SignalGenerators] --> [GPUContext]
[FFTProcessor] --> [GPUContext]
[Filters] --> [GPUContext]
[Statistics] --> [GPUContext]
[Heterodyne] --> [GPUContext]
[pybind11] --> [Modules]

@enduml
