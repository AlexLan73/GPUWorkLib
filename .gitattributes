# По умолчанию текстовые файлы, хранить с LF
* text=auto eol=lf

# Явно: код и скрипты только LF
*.c      text eol=lf
*.cpp    text eol=lf
*.cxx    text eol=lf
*.h      text eol=lf
*.hpp    text eol=lf
*.inl    text eol=lf

*.py     text eol=lf
*.sh     text eol=lf
*.bat    text eol=lf
*.ps1    text eol=lf

*.cmake  text eol=lf
CMakeLists.txt text eol=lf

*.md     text eol=lf
*.txt    text eol=lf
*.json   text eol=lf

# Бинарники не трогаем
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.bmp    binaryclear
*.ico    binary
*.exe    binary
*.dll    binary
*.lib    binary
*.pdb    binary
*.zip    binary
*.7z     binary
*.pdf    binary
